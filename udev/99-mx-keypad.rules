# Logitech MX Keypad / MX Creative Console
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c354", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c354", MODE="0666"

# Virtual keyboard for shortcuts / media keys
KERNEL=="uinput", MODE="0666", OPTIONS+="static_node=uinput"
